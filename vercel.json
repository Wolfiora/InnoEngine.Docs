{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "routes": [
    {
      "src": "^/$",
      "status": 307,
      "headers": {
        "Location": "/InnoEngine.Docs/"
      }
    },
    {
      "src": "^/InnoEngine.Docs/navigation-data/[a-f0-9]{64}\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/InnoEngine.Docs/404.html",
      "status": 404
    }
  ]
}

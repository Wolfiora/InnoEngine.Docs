---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { navigation, selectedTypes } from '../../scripts/site-navigation.mjs';
const currentPath = decodeURI(Astro.url.pathname).replace(/\/?$/, '/');
const currentTrail = navigation.trails.get(currentPath) ?? [];
---
<inno-sidebar data-pagefind-ignore data-current-trail={JSON.stringify(currentTrail)} data-selected-type={selectedTypes.get(currentPath)}>
  <ul class="root">
    {navigation.roots.map(entry => <li data-key={entry.key}>
      <div class="nav-row root-row">
        {entry.children && <button type="button" class="toggle whole-row" aria-expanded="false" aria-current={entry.href === currentPath ? 'page' : undefined} aria-label={`Toggle ${entry.label}`} data-children={entry.children}>
          <span class="caret chevron" aria-hidden="true"></span><span class="nav-label">{entry.label}</span>
        </button>}
        {!entry.children && entry.href && <a class="nav-label" href={entry.href}>{entry.label}</a>}
      </div>
    </li>)}
  </ul>
  <noscript><p>Browse the <a href="/InnoEngine.Docs/">documentation home</a> or <a href="/InnoEngine.Docs/api/">API category tables</a>.</p></noscript>
</inno-sidebar>
<div class="md:sl-hidden"><MobileMenuFooter /></div>
<script src="../scripts/sidebar.ts"></script>
<style is:global>
  .sidebar-pane { overflow-anchor: none; --nav-edge-gap: .5rem; }
  .sidebar-pane .sidebar-content { padding-inline-end: var(--nav-edge-gap); }
  inno-sidebar {
    display: block;
    --nav-motion: 220ms;
    --nav-easing: cubic-bezier(.2, .7, .3, 1);
    ul { list-style: none; padding: 0; margin: 0; }
    li { margin-block: .18rem; overflow-wrap: anywhere; }
    .root > li { margin-block: .3rem; }
    .children-inner > ul { margin-inline-start: .85rem; border-inline-start: 1px solid var(--sl-color-hairline-light); }
    .nav-row { margin-inline-start: var(--nav-edge-gap); display: flex; align-items: stretch; min-height: 2.35rem; border-radius: .25rem; color: var(--sl-color-gray-2); transition: background-color 120ms ease; }
    .nav-row:hover { background: color-mix(in srgb, var(--sl-color-gray-2) 9%, transparent); }
    .nav-row > a, .nav-label { min-width: 0; padding: .4rem .5rem .4rem 0; line-height: 1.45; }
    .nav-row > a { flex: 1; color: inherit; background: transparent; text-decoration: none; }
    .nav-row > a:only-child { padding-inline-start: 2rem; }
    .toggle { display: grid; place-items: center; flex: 0 0 2rem; padding: 0; color: inherit; background: none; border: 0; font: inherit; text-align: start; cursor: pointer; }
    .toggle.whole-row { flex: 1; grid-template-columns: 2rem minmax(0, 1fr); line-height: 1.45; }
    .whole-row .nav-label { justify-self: stretch; }
    .caret { display: block; position: relative; box-sizing: border-box; width: .9rem; height: .9rem; border: 1.5px solid currentColor; border-radius: 3px; opacity: .8; }
    .caret::before, .caret::after { content: ''; position: absolute; inset: 50% auto auto 50%; background: currentColor; border-radius: 1px; transform: translate(-50%, -50%); }
    .caret::before { width: .48rem; height: 1.5px; }
    .caret::after { width: 1.5px; height: .48rem; transition: transform var(--nav-motion) var(--nav-easing); }
    [aria-expanded='true'] .caret::after { transform: translate(-50%, -50%) scaleY(0); }
    .caret.chevron { width: .75rem; height: .75rem; border: 0; opacity: 1; transition: transform var(--nav-motion) var(--nav-easing); }
    .chevron::before { width: .45rem; height: .45rem; background: none; border-block-start: 2px solid currentColor; border-inline-end: 2px solid currentColor; border-radius: 1px; transform: translate(-65%, -50%) rotate(45deg); }
    .chevron::after { display: none; }
    [aria-expanded='true'] .chevron { transform: rotate(90deg); }
    .children { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows var(--nav-motion) var(--nav-easing), opacity var(--nav-motion) var(--nav-easing); }
    .children[data-open='true'] { grid-template-rows: 1fr; opacity: 1; }
    .children-inner { min-height: 0; overflow: hidden; }
    .children[hidden] { display: none; }
    .nav-row:has(> [aria-expanded='true']) { background: color-mix(in srgb, var(--sl-color-hairline-light) 50%, transparent); }
    .nav-row:has(> [aria-expanded='true']):hover { background: var(--sl-color-hairline-light); }
    li:has([aria-current='page']) > .nav-row { background: color-mix(in srgb, var(--sl-color-text-accent) 5%, transparent); color: var(--sl-color-text); }
    li:has([aria-current='page']) > .nav-row .nav-label { font-weight: 650; }
    .nav-row > .nav-label[aria-current='page'] { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
    li:has([aria-current='page']) > .nav-row:hover { background: color-mix(in srgb, var(--sl-color-text-accent) 9%, transparent); }
    li > .nav-row:has(> [aria-current='page'], > [data-selected-type]) { background: color-mix(in srgb, var(--sl-color-text-accent) 28%, transparent); }
    li > .nav-row:has(> [aria-current='page'], > [data-selected-type]):hover { background: color-mix(in srgb, var(--sl-color-text-accent) 34%, transparent); }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: -2px; }
    .nav-error { padding: .4rem; color: var(--sl-color-text); font-size: .85rem; }
    &[data-restoring] .children { transition: none; }
  }
  /* The left tree grows independently; preserve readable body space beside the resizable TOC. */
  @media (min-width: 50rem) {
    :root[data-has-sidebar] { --sl-content-inline-start: min(var(--inno-sidebar-width, 18rem), 50vw); }
    .sidebar-pane { width: min(var(--inno-sidebar-width, 18rem), 50vw); overflow-x: clip; transition: width 220ms cubic-bezier(.2, .7, .3, 1); }
    .sidebar-pane .sidebar-content { width: calc(min(var(--inno-sidebar-width, 18rem), 50vw) - var(--inno-sidebar-gutter, 0px)); box-sizing: border-box; }
    .main-frame { transition: padding-inline-start 220ms cubic-bezier(.2, .7, .3, 1); }
    :root[data-sidebar-restoring] .sidebar-pane, :root[data-sidebar-restoring] .main-frame { transition: none; }
  }
  @media (min-width: 72rem) {
    :root[data-has-sidebar][data-has-toc] { --sl-content-inline-start: min(var(--inno-sidebar-width, 18rem), 50vw, calc(100vw - var(--inno-toc-width, 25vw) - 18rem)); }
    [data-has-toc] .sidebar-pane { width: var(--sl-content-inline-start); }
    [data-has-toc] .sidebar-pane .sidebar-content { width: calc(var(--sl-content-inline-start) - var(--inno-sidebar-gutter, 0px)); }
  }
</style>

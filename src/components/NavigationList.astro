---
type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
interface Props { entries: Entry[]; nested?: boolean }
const { entries, nested = false } = Astro.props;
const section = (href: string) => href.startsWith(import.meta.env.BASE_URL)
  ? href.slice(import.meta.env.BASE_URL.length).split('/').filter(Boolean)[0] : undefined;
function current(entry: Entry): boolean {
  return entry.type === 'link'
    ? entry.isCurrent || (entry.attrs['data-group-home'] === 'true' && Astro.url.pathname.startsWith(entry.href))
    : entry.entries.some(current);
}
---
<ul class:list={{ 'inno-navigation': !nested, nested }}>
  {entries.map(entry => {
    if (entry.type === 'link') return <li><a {...entry.attrs} href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined}>{entry.label}</a></li>;
    const home = entry.entries.find(child => child.type === 'link' && child.attrs['data-group-home'] === 'true')
      ?? (!nested && entry.entries[0]?.type === 'link' ? entry.entries[0] : undefined);
    const active = current(entry) || (!nested && home?.type === 'link' && section(home.href) === section(Astro.url.pathname));
    if (!nested && home?.type === 'link' && !active)
      return <li><a class="section-home" href={home.href}>{entry.label}</a></li>;
    // Category tables own the complete hierarchy. Keep the current branch expanded,
    // with sibling category links, instead of repeating every closed subtree on every symbol page.
    if (home?.type === 'link' && /\/api\/(engine|scripting)\/.+/.test(home.href) && !current(entry))
      return <li><a href={home.href}>{entry.label}</a></li>;
    const children = entry.entries.filter(child => child !== home);
    return <li><details open={active || !entry.collapsed}>
      <summary aria-label={`Expand or collapse ${entry.label}`}>
        {home?.type === 'link' ? <a href={home.href} aria-current={home.isCurrent ? 'page' : undefined}>{entry.label}</a> : <span>{entry.label}</span>}
        <span class="caret" aria-hidden="true">›</span>
      </summary>
      <Astro.self entries={children} nested />
    </details></li>;
  })}
</ul>
<style is:global>
  .inno-navigation, .inno-navigation ul { list-style: none; padding: 0; margin: 0; }
  .inno-navigation > li + li { margin-top: .6rem; }
  .inno-navigation .nested { margin-left: .6rem; padding-left: .5rem; border-left: 1px solid var(--sl-color-hairline-light); }
  .inno-navigation a { display: block; color: var(--sl-color-gray-2); text-decoration: none; padding: .3rem .5rem; border-radius: .25rem; overflow-wrap: anywhere; }
  .inno-navigation a:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
  .inno-navigation .section-home { font-weight: 600; color: var(--sl-color-white); }
  .inno-navigation a[aria-current='page'] { color: var(--sl-color-text-invert); background: var(--sl-color-text-accent); font-weight: 600; }
  .inno-navigation summary { display: flex; align-items: center; gap: .4rem; cursor: pointer; font-weight: 600; color: var(--sl-color-white); padding: .15rem .5rem; }
  .inno-navigation summary::marker, .inno-navigation summary::-webkit-details-marker { display: none; }
  .inno-navigation summary > a { flex: 1; margin-left: -.5rem; }
  .inno-navigation summary > span:first-child { flex: 1; }
  .inno-navigation .caret { font-size: 1.5rem; line-height: 1; padding: .2rem; }
  .inno-navigation details[open] > summary > .caret { transform: rotate(90deg); }
</style>

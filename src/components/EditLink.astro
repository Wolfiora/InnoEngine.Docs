---
const { entry } = Astro.locals.starlightRoute;
const source = entry.filePath?.replaceAll('\\', '/');
const href = source?.startsWith('content/en/')
  ? 'https://github.com/Wolfiora/InnoEngine.Docs/edit/draft/' + source.split('/').map(encodeURIComponent).join('/')
  : undefined;
---
<div class="source-actions">
  {entry.data.sourceDeclaration && <a href={entry.data.sourceDeclaration}>Source declaration</a>}
  {href && <a href={href}>Edit this page on GitHub</a>}
</div>
<style>
  .source-actions { display: flex; flex-direction: column; align-items: flex-start; gap: .25rem; }
</style>
